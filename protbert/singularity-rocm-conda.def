Bootstrap: docker
From: rocm/pytorch:rocm7.2_ubuntu24.04_py3.12_pytorch_release_2.9.1

%post
    echo "--- Updating apt and installing basics ---"
    apt-get update && apt-get install -y wget git && rm -rf /var/lib/apt/lists/*

    echo "--- Installing the python packages ---"
    pip3 install transformers multiprocess numpy pandas polars tokenizers tqdm scikit-learn wandb torchmetrics && \
    pip3 install "pyyaml>=6.0,<7" "tqdm>=4.62.3,<5" "torchmetrics>=1.0,<1.7.5" "torch_optimizer>=0.3.0,<0.4" \
    "requests>=2.26.0,<3" "numpy>=1.21.5,<2.3.0" "psutil>=5.8.0,<8" "coolname>=1.1.0,<3" "tabulate==0.9.0" \
    "py-cpuinfo>=8.0.0,<10" "packaging>=21.3.0,<25.1" "importlib-metadata>=5.0.0,<9" "mosaicml-cli>=0.5.25,<0.8" "pillow>=10.3.0,<12" && \
    pip3 install mosaicml --no-deps



%environment
    export PATH="/usr/local/bin:${PATH}"

%runscript
    echo "Welcome at the ROCm PyTorch Singularity container!"
    exec /bin/bash "$@"
