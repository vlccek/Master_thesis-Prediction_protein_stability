    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"initial_id\",\n",
    "   \"metadata\": {\n",
    "    \"collapsed\": true,\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-09-29T13:00:59.975438Z\",\n",
    "     \"start_time\": \"2025-09-29T13:00:58.159607Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --- 1. Nastavení parametrů pro plynulejší tvar ---\\n\",\n",
    "    \"plate_radius = 1.0\\n\",\n",
    "    \"depth = 25\\n\",\n",
    "    \"\\n\",\n",
    "    \"# <-- ZMĚNA: Parametry upraveny pro maximální plynulost\\n\",\n",
    "    \"main_width = 0.5    # Mírně širší hlavní propad\\n\",\n",
    "    \"bulge_radius = 0.28 # Posunutí \\\"břicha\\\" dál od středu\\n\",\n",
    "    \"bulge_amount = 6    # Mírně menší rozšíření\\n\",\n",
    "    \"bulge_width = 0.22  # VÝRAZNĚ širší \\\"břicho\\\" pro plynulý přechod\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --- 2. Vytvoření dat pro povrch ---\\n\",\n",
    "    \"# Použijeme hustou síť bodů pro vysokou přesnost\\n\",\n",
    "    \"r = np.linspace(0.01, plate_radius, 400)\\n\",\n",
    "    \"theta = np.linspace(0, 2 * np.pi, 400)\\n\",\n",
    "    \"R, Theta = np.meshgrid(r, theta)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Převod polárních souřadnic na kartézské (X, Y)\\n\",\n",
    "    \"X = R * np.cos(Theta)\\n\",\n",
    "    \"Y = R * np.sin(Theta)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Definice rovnice povrchu\\n\",\n",
    "    \"def calculate_z(radius):\\n\",\n",
    "    \"    main_drop = -depth * np.exp(-(radius**2) / main_width**2)\\n\",\n",
    "    \"    bulge = bulge_amount * np.exp(-((radius - bulge_radius)**2) / bulge_width**2)\\n\",\n",
    "    \"    return main_drop + bulge\\n\",\n",
    "    \"\\n\",\n",
    "    \"Z = calculate_z(R)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --- 3. Vytvoření dat pro geodetické křivky a body ---\\n\",\n",
    "    \"geodesics = []\\n\",\n",
    "    \"for angle in [np.pi / 2, 1.25 * np.pi, 1.75 * np.pi]:\\n\",\n",
    "    \"    r_geo = np.linspace(plate_radius * 0.95, 0.02, 150)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    curvature_strength = 0.1\\n\",\n",
    "    \"    theta_geo = angle + curvature_strength * (1/r_geo - 1/(plate_radius * 0.95))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    x_geo = r_geo * np.cos(theta_geo)\\n\",\n",
    "    \"    y_geo = r_geo * np.sin(theta_geo)\\n\",\n",
    "    \"    z_geo = calculate_z(r_geo)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    geodesics.append((x_geo, y_geo, z_geo))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Body na křivkách\\n\",\n",
    "    \"points = []\\n\",\n",
    "    \"for x_geo, y_geo, z_geo in geodesics:\\n\",\n",
    "    \"    points.append((x_geo[25], y_geo[25], z_geo[25]))\\n\",\n",
    "    \"    points.append((x_geo[80], y_geo[80], z_geo[80]))\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --- 4. Vykreslení obrázku ---\\n\",\n",
    "    \"fig = plt.figure(figsize=(10, 8))\\n\",\n",
    "    \"ax = fig.add_subplot(111, projection='3d')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# <-- ZMĚNA: Snížení rstride/cstride pro vizuální vyhlazení povrchu\\n\",\n",
    "    \"surface = ax.plot_surface(\\n\",\n",
    "    \"    X, Y, Z,\\n\",\n",
    "    \"    cmap='cividis',\\n\",\n",
    "    \"    alpha=0.95,\\n\",\n",
    "    \"    rstride=2,  # Vykreslí každou 2. řadu (mnohem hustší síť)\\n\",\n",
    "    \"    cstride=2,  # Vykreslí každý 2. sloupec\\n\",\n",
    "    \"    antialiased=True,\\n\",\n",
    "    \"    linewidth=0.05 # Tenčí čáry mřížky\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Vykreslení koncentrických kružnic\\n\",\n",
    "    \"for radius in list(np.linspace(0.5, plate_radius, 4)) + [bulge_radius]:\\n\",\n",
    "    \"    theta_line = np.linspace(0, 2 * np.pi, 200)\\n\",\n",
    "    \"    x_line = radius * np.cos(theta_line)\\n\",\n",
    "    \"    y_line = radius * np.sin(theta_line)\\n\",\n",
    "    \"    z_line = calculate_z(np.array([radius]))\\n\",\n",
    "    \"    ax.plot(x_line, y_line, z_line + 0.1, color='black', lw=0.6)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Vykreslení geodetických křivek a bodů\\n\",\n",
    "    \"for x_geo, y_geo, z_geo in geodesics:\\n\",\n",
    "    \"    ax.plot(x_geo, y_geo, z_geo, color='black', lw=1.5)\\n\",\n",
    "    \"for p in points:\\n\",\n",
    "    \"    ax.scatter(p[0], p[1], p[2], color='black', s=50)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --- 5. Přizpůsobení vzhledu grafu ---\\n\",\n",
    "    \"ax.view_init(elev=30, azim=-60)\\n\",\n",
    "    \"ax.set_axis_off()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Automatické nastavení limitu osy Z\\n\",\n",
    "    \"min_z_val = Z.min()\\n\",\n",
    "    \"ax.set_zlim(min_z_val * 1.1, 5)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
