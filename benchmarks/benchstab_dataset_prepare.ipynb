    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"# 1. LOAD DAT\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Clean PDB IDs and extract roots\\n\",\n",
    "    \"df = df.with_columns(pl.col(\\\"pdb\\\").str.to_uppercase().alias(\\\"pdb_id\\\"))\\n\",\n",
    "    \"unique_pdb_roots = df[\\\"pdb_id\\\"].unique().to_list()\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Unique PDBs: {len(unique_pdb_roots)}\\\")\"\n",
    "   ],\n",
    "   \"id\": \"932a063760e0f36\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"Unique PDBs: 35\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 47\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"2\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-03-31T13:43:37.174742997Z\",\n",
    "     \"start_time\": \"2026-03-31T13:43:37.046446705Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# 2. DOWNLOAD PDB SEQUENCES\\n\",\n",
    "    \"def parse_fasta_to_dict(fasta_string):\\n\",\n",
    "    \"    if not fasta_string: return {}\\n\",\n",
    "    \"    chains = {}\\n\",\n",
    "    \"    try:\\n\",\n",
    "    \"        file = StringIO(fasta_string)\\n\",\n",
    "    \"        for record in SeqIO.parse(file, \\\"fasta\\\"):\\n\",\n",
    "    \"            header = record.description\\n\",\n",
    "    \"            seq = str(record.seq)\\n\",\n",
    "    \"            # Extract chain ID from header\\n\",\n",
    "    \"            # Example: >4V4M_1|Chain A|S-adenosylmethionine synthetase|Escherichia coli (511145)\\n\",\n",
    "    \"            # Or: >1AZP_1|Chains A, B|... \\n\",\n",
    "    \"            match = re.search(r\\\"Chain[s]?\\\\s+([A-Za-z0-9, ]+)\\\", header)\\n\",\n",
    "    \"            if match:\\n\",\n",
    "    \"                # Handle multiple chains if listed (e.g., \\\"A, B\\\")\\n\",\n",
    "    \"                chain_ids = [c.strip() for c in match.group(1).split(\\\",\\\")]\\n\",\n",
    "    \"                for cid in chain_ids:\\n\",\n",
    "    \"                    chains[cid] = seq\\n\",\n",
    "    \"            else:\\n\",\n",
    "    \"                # Fallback to record ID part after underscore\\n\",\n",
    "    \"                if \\\"_\\\" in record.id:\\n\",\n",
    "    \"                    chains[record.id.split(\\\"_\\\")[1]] = seq\\n\",\n",
    "    \"                else:\\n\",\n",
    "    \"                    chains[record.id] = seq\\n\",\n",
    "    \"    except Exception as e:\\n\",\n",
    "    \"        print(f\\\"Error parsing FASTA: {e}\\\")\\n\",\n",
    "    \"        return {}\\n\",\n",
    "    \"    return chains\\n\",\n",
    "    \"\\n\",\n",
    "    \"chains_cache = {}\\n\",\n",
    "    \"if os.path.exists(CACHE_FILE):\\n\",\n",
    "    \"    with open(CACHE_FILE, \\\"r\\\") as f:\\n\",\n",
    "    \"        chains_cache = json.load(f)\\n\",\n",
    "    \"\\n\",\n",
    "    \"ids_to_download = [pid for pid in unique_pdb_roots if pid not in chains_cache]\\n\",\n",
    "    \"\\n\",\n",
    "    \"if ids_to_download:\\n\",\n",
    "    \"    print(f\\\"Downloading {len(ids_to_download)} PDB records...\\\")\\n\",\n",
    "    \"    for i, pdb_id in enumerate(ids_to_download):\\n\",\n",
    "    \"        try:\\n\",\n",
    "    \"            url = f\\\"https://www.rcsb.org/fasta/entry/{pdb_id}\\\"\\n\",\n",
    "    \"            response = requests.get(url, timeout=10)\\n\",\n",
    "    \"            if response.status_code == 200:\\n\",\n",
    "    \"                chains_cache[pdb_id] = parse_fasta_to_dict(response.text)\\n\",\n",
    "    \"            else:\\n\",\n",
    "    \"                chains_cache[pdb_id] = {}\\n\",\n",
    "    \"            if i % 10 == 0: time.sleep(0.1)\\n\",\n",
    "    \"        except:\\n\",\n",
    "    \"            chains_cache[pdb_id] = {}\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    with open(CACHE_FILE, \\\"w\\\") as f:\\n\",\n",
    "    \"        json.dump(chains_cache, f)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Download complete.\\\")\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"Download complete.\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 48\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"3\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-03-31T13:43:37.340491205Z\",\n",
    "     \"start_time\": \"2026-03-31T13:43:37.227930681Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# 3. GENERATE SEQUENCES\\n\",\n",
    "    \"def get_sequences(row):\\n\",\n",
    "    \"    pdb_id = row[\\\"pdb_id\\\"]\\n\",\n",
    "    \"    mut_str = row[\\\"mutation\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Standard mutation format: A123B (WT, Pos, Mut)\\n\",\n",
    "    \"    match = re.match(r\\\"([A-Z])(\\\\d+)([A-Z])\\\", mut_str)\\n\",\n",
    "    \"    if not match: return None, None\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    wt_aa, pos, mut_aa = match.groups()\\n\",\n",
    "    \"    pos = int(pos)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    pdb_data = chains_cache.get(pdb_id, {})\\n\",\n",
    "    \"    # Try chain A first, then any available chain\\n\",\n",
    "    \"    seq = pdb_data.get(\\\"A\\\")\\n\",\n",
    "    \"    if not seq and pdb_data:\\n\",\n",
    "    \"        seq = list(pdb_data.values())[0]\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    if not seq:\\n\",\n",
    "    \"        return None, None\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Mutation index (usually 1-indexed in PDB reports)\\n\",\n",
    "    \"    # Check if WT amino acid matches\\n\",\n",
    "    \"    idx = pos - 1\\n\",\n",
    "    \"    if idx < 0 or idx >= len(seq):\\n\",\n",
    "    \"        # Try offset if 0-indexed or 1-indexed mismatch\\n\",\n",
    "    \"        # Some datasets have offsets, but let's try direct first\\n\",\n",
    "    \"        return None, None\\n\",\n",
    "    \"        \\n\",\n",
    "    \"    if seq[idx] != wt_aa:\\n\",\n",
    "    \"        # Search for the WT amino acid in the vicinity if possible?\\n\",\n",
    "    \"        # For now, strict match\\n\",\n",
    "    \"        return None, None\\n\",\n",
    "    \"        \\n\",\n",
    "    \"    mut_seq = seq[:idx] + mut_aa + seq[idx+1:]\\n\",\n",
    "    \"    return seq, mut_seq\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Generating sequences...\\\")\\n\",\n",
    "    \"wt_seqs = []\\n\",\n",
    "    \"mut_seqs = []\\n\",\n",
    "    \"rows = df.to_dicts()\\n\",\n",
    "    \"\\n\",\n",
    "    \"for row in rows:\\n\",\n",
    "    \"    wt, mut = get_sequences(row)\\n\",\n",
    "    \"    wt_seqs.append(wt)\\n\",\n",
    "    \"    mut_seqs.append(mut)\\n\",\n",
    "    \"\\n\",\n",
    "    \"df = df.with_columns([\\n\",\n",
    "    \"    pl.Series(\\\"wt_sequence\\\", wt_seqs),\\n\",\n",
    "    \"    pl.Series(\\\"mut_sequence\\\", mut_seqs)\\n\",\n",
    "    \"])\\n\",\n",
    "    \"\\n\",\n",
    "    \"df.filter(pl.col(\\\"wt_sequence\\\").is_null())\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"Generating sequences...\\n\"\n",
    "     ]\n",
    "    },\n",
    "    {\n",
    "     \"data\": {\n",
    "      \"text/plain\": [\n",
    "       \"shape: (76, 7)\\n\",\n",
    "       \"┌──────┬──────────┬───────────┬─────────────────┬────────┬─────────────┬──────────────┐\\n\",\n",
    "       \"│ pdb  ┆ mutation ┆ ddg_value ┆ predicted_value ┆ pdb_id ┆ wt_sequence ┆ mut_sequence │\\n\",\n",
    "       \"│ ---  ┆ ---      ┆ ---       ┆ ---             ┆ ---    ┆ ---         ┆ ---          │\\n\",\n",
    "       \"│ str  ┆ str      ┆ f64       ┆ f64             ┆ str    ┆ str         ┆ str          │\\n\",\n",
    "       \"╞══════╪══════════╪═══════════╪═════════════════╪════════╪═════════════╪══════════════╡\\n\",\n",
    "       \"│ 1DPM ┆ H257L    ┆ 3.3       ┆ 0.020544        ┆ 1DPM   ┆ null        ┆ null         │\\n\",\n",
    "       \"│ 1EL1 ┆ A93S     ┆ 0.26      ┆ 0.468469        ┆ 1EL1   ┆ null        ┆ null         │\\n\",\n",
    "       \"│ 1EL1 ┆ I56L     ┆ 0.24      ┆ -0.367536       ┆ 1EL1   ┆ null        ┆ null         │\\n\",\n",
    "       \"│ 1EL1 ┆ H21G     ┆ 0.48      ┆ 0.382251        ┆ 1EL1   ┆ null        ┆ null         │\\n\",\n",
    "       \"│ 1EL1 ┆ V109K    ┆ 0.43      ┆ 0.39397         ┆ 1EL1   ┆ null        ┆ null         │\\n\",\n",
    "       \"│ …    ┆ …        ┆ …         ┆ …               ┆ …      ┆ …           ┆ …            │\\n\",\n",
    "       \"│ 2ZTA ┆ E20Q     ┆ -0.2      ┆ -0.013159       ┆ 2ZTA   ┆ null        ┆ null         │\\n\",\n",
    "       \"│ 2ZTA ┆ K15A     ┆ 0.41      ┆ 0.005446        ┆ 2ZTA   ┆ null        ┆ null         │\\n\",\n",
    "       \"│ 2ZTA ┆ K8A      ┆ 0.39      ┆ -0.024939       ┆ 2ZTA   ┆ null        ┆ null         │\\n\",\n",
    "       \"│ 4BLM ┆ S265C    ┆ 2.4       ┆ -0.979096       ┆ 4BLM   ┆ null        ┆ null         │\\n\",\n",
    "       \"│ 4BLM ┆ S126C    ┆ 2.7       ┆ 0.053304        ┆ 4BLM   ┆ null        ┆ null         │\\n\",\n",
    "       \"└──────┴──────────┴───────────┴─────────────────┴────────┴─────────────┴──────────────┘\"\n",
