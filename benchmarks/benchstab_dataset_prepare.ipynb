    "    \"import time\\n\",\n",
    "    \"import re\\n\",\n",
    "    \"from Bio import SeqIO\\n\",\n",
    "    \"from io import StringIO\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Create directories\\n\",\n",
    "    \"if not os.path.exists(\\\".cache\\\"):\\n\",\n",
