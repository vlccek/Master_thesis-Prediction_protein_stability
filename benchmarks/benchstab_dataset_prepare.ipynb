    "    \"if not os.path.exists(\\\"datasets\\\"):\\n\",\n",
    "    \"    os.makedirs(\\\"datasets\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --- CONFIGURATION ---\\n\",\n",
    "    \"INPUT_FILE = \\\"../data/benchstab.csv\\\"\\n\",\n",
    "    \"CACHE_FILE = \\\".cache/pdb_chains_cache.json\\\"\\n\",\n",
    "    \"OUTPUT_PARQUET = \\\"datasets/benchstab_prepared.parquet\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"df = pl.read_csv(INPUT_FILE)\\n\",\n",
    "    \"# Normalize column names - remove leading/trailing whitespace\\n\",\n",
    "    \"df = df.rename({col: col.strip() for col in df.columns})\\n\",\n",
    "    \"\\n\",\n",
    "    \"df\"\n",
