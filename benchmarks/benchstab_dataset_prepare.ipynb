    "       \"<div><style>\\n\",\n",
    "       \".dataframe > thead > tr,\\n\",\n",
    "       \".dataframe > tbody > tr {\\n\",\n",
    "       \"  text-align: right;\\n\",\n",
    "       \"  white-space: pre-wrap;\\n\",\n",
    "       \"}\\n\",\n",
    "       \"</style>\\n\",\n",
    "       \"<small>shape: (76, 7)</small><table border=\\\"1\\\" class=\\\"dataframe\\\"><thead><tr><th>pdb</th><th>mutation</th><th>ddg_value</th><th>predicted_value</th><th>pdb_id</th><th>wt_sequence</th><th>mut_sequence</th></tr><tr><td>str</td><td>str</td><td>f64</td><td>f64</td><td>str</td><td>str</td><td>str</td></tr></thead><tbody><tr><td>&quot;1DPM&quot;</td><td>&quot;H257L&quot;</td><td>3.3</td><td>0.020544</td><td>&quot;1DPM&quot;</td><td>null</td><td>null</td></tr><tr><td>&quot;1EL1&quot;</td><td>&quot;A93S&quot;</td><td>0.26</td><td>0.468469</td><td>&quot;1EL1&quot;</td><td>null</td><td>null</td></tr><tr><td>&quot;1EL1&quot;</td><td>&quot;I56L&quot;</td><td>0.24</td><td>-0.367536</td><td>&quot;1EL1&quot;</td><td>null</td><td>null</td></tr><tr><td>&quot;1EL1&quot;</td><td>&quot;H21G&quot;</td><td>0.48</td><td>0.382251</td><td>&quot;1EL1&quot;</td><td>null</td><td>null</td></tr><tr><td>&quot;1EL1&quot;</td><td>&quot;V109K&quot;</td><td>0.43</td><td>0.39397</td><td>&quot;1EL1&quot;</td><td>null</td><td>null</td></tr><tr><td>&hellip;</td><td>&hellip;</td><td>&hellip;</td><td>&hellip;</td><td>&hellip;</td><td>&hellip;</td><td>&hellip;</td></tr><tr><td>&quot;2ZTA&quot;</td><td>&quot;E20Q&quot;</td><td>-0.2</td><td>-0.013159</td><td>&quot;2ZTA&quot;</td><td>null</td><td>null</td></tr><tr><td>&quot;2ZTA&quot;</td><td>&quot;K15A&quot;</td><td>0.41</td><td>0.005446</td><td>&quot;2ZTA&quot;</td><td>null</td><td>null</td></tr><tr><td>&quot;2ZTA&quot;</td><td>&quot;K8A&quot;</td><td>0.39</td><td>-0.024939</td><td>&quot;2ZTA&quot;</td><td>null</td><td>null</td></tr><tr><td>&quot;4BLM&quot;</td><td>&quot;S265C&quot;</td><td>2.4</td><td>-0.979096</td><td>&quot;4BLM&quot;</td><td>null</td><td>null</td></tr><tr><td>&quot;4BLM&quot;</td><td>&quot;S126C&quot;</td><td>2.7</td><td>0.053304</td><td>&quot;4BLM&quot;</td><td>null</td><td>null</td></tr></tbody></table></div>\"\n",
    "      ]\n",
    "     },\n",
    "     \"execution_count\": 49,\n",
    "     \"metadata\": {},\n",
    "     \"output_type\": \"execute_result\"\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 49\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-03-31T15:02:10.842962750Z\",\n",
    "     \"start_time\": \"2026-03-31T15:02:10.542567659Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"k_neg = 0.230\\n\",\n",
    "    \"k_pos = 0.576\\n\",\n",
    "    \"A_neg = 1.0\\n\",\n",
    "    \"A_pos = 1.0\\n\",\n",
    "    \"\\n\",\n",
    "    \"sigmoid_expr = (\\n\",\n",
    "    \"    pl.when(pl.col(\\\"ddg_value\\\") <= 0) # Stabilizující a neutrální\\n\",\n",
    "    \"    .then(A_pos * (2 / (1 + (-k_pos * (-pl.col(\\\"ddg_value\\\"))).exp()) - 1))\\n\",\n",
    "    \"    .otherwise(-A_neg * (2 / (1 + (-k_neg * (pl.col(\\\"ddg_value\\\"))).exp()) - 1))\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"df_final = df.with_columns(\\n\",\n",
    "    \"    sigmoid_expr.alias(\\\"target\\\")\\n\",\n",
    "    \")\\n\",\n",
